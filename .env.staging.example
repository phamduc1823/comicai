# ==============================================================================
# ComicAI — Staging Environment Template (.env.staging.example)
# Isolated Staging Configuration for Pre-deployment & E2E Testing
# Port: 8088 | Database: comicai_staging | Redis DB: 1
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core Configuration
# ------------------------------------------------------------------------------
APP_NAME=ComicAI_Staging
APP_ENV=staging
APP_KEY=base64:GENERATE_VIA_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=true
APP_URL=http://localhost:8088
PORT=8088

# ------------------------------------------------------------------------------
# 2. Dedicated Staging Database (MySQL 8.4 LTS)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=comicai_staging
DB_USERNAME=comicai_staging_user
DB_PASSWORD=staging_password_change_me
DB_ROOT_PASSWORD=staging_root_change_me

# ------------------------------------------------------------------------------
# 3. Redis In-Memory Cache, Session & Queue
# ------------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=staging_redis_secret_change_me

# ------------------------------------------------------------------------------
# 4. Laravel Reverb WebSocket Server (Realtime Chat)
# ------------------------------------------------------------------------------
REVERB_APP_ID=comicai_staging_app
REVERB_APP_KEY=comicai_staging_key
REVERB_APP_SECRET=staging_reverb_secret_change_me
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_CLIENT_PORT=8088
REVERB_CLIENT_SCHEME=http

# ------------------------------------------------------------------------------
# 5. Gemini AI Search (Staging Mode)
# ------------------------------------------------------------------------------
AI_SEARCH_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
AI_REQUEST_TIMEOUT=8
AI_HYBRID_ALPHA=0.55
AI_SEMANTIC_THRESHOLD=0.35
AI_HYBRID_CANDIDATE_LIMIT=100
AI_QUERY_EMBEDDING_CACHE_TTL=604800

# ------------------------------------------------------------------------------
# 6. VIP Chapter & Coin Wallet Pricing
# ------------------------------------------------------------------------------
VIP_WELCOME_BONUS_COINS=100
VIP_FAUCET_ENABLED=true
VIP_FAUCET_DAILY_LIMIT=5
VIP_FAUCET_AMOUNT=100
VIP_CHAPTER_MIN_PRICE=5
VIP_CHAPTER_MAX_PRICE=50

# ------------------------------------------------------------------------------
# 7. Frontend Vite Staging Arguments
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8088
VITE_REVERB_APP_KEY=comicai_staging_key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8088
VITE_REVERB_SCHEME=http
