# ==============================================================================
# BlueToon Monorepo — Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (Bảo vệ bí mật & biến môi trường)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.*.example

frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.*.example

# Secret keys, private certificates & tokens
*.pem
*.key
*.pfx
*.p12
id_rsa*
oauth-private.key
oauth-public.key

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers (Loại trừ thư viện ngoài)
# ------------------------------------------------------------------------------
# PHP / Composer
/vendor/
backend/vendor/

# Node / NPM / Yarn / PNPM
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Build Artifacts, Cache & Generated Files (File sinh tự động)
# ------------------------------------------------------------------------------
# Frontend build outputs & Vite cache
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.local

# Backend / Laravel cache & logs
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore

backend/storage/app/*
!backend/storage/app/.gitignore
!backend/storage/app/public/
backend/storage/app/public/*
!backend/storage/app/public/.gitignore

backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore

backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore

backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore

backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore

backend/storage/logs/*
!backend/storage/logs/.gitignore
!backend/storage/logs/.gitkeep

backend/storage/oauth-*.key

# Test results & Coverage
.phpunit.result.cache
backend/.phpunit.result.cache
coverage/
backend/coverage/
frontend/coverage/
*.lcov

# ------------------------------------------------------------------------------
# 4. OS & System Files (Hệ điều hành)
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 5. IDE & Editor Specific Files (Công cụ lập trình)
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak

# VS Code (Giữ lại cấu hình chia sẻ nếu cần, bỏ qua dữ liệu cục bộ)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 6. Internal Documentation & Agent Instructions (Loại trừ tài liệu nội bộ)
# ------------------------------------------------------------------------------
/AI/
/AGENTS.md
