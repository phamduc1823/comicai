# BlueToon Frontend Environment Variables Template
# Copy this file to .env or .env.local for local configuration.

# Application Information
VITE_APP_TITLE=BlueToon
VITE_APP_ENV=development

# Frontend API Base URL (SPA requests prefix)
# In development, requests starting with /api are proxied to the Laravel backend by Vite.
VITE_API_BASE_URL=/api

# Laravel Backend Target URL (for Vite dev server proxy)
# Default Laravel development server address:
VITE_API_TARGET_URL=http://127.0.0.1:8000
